diff --git a/host/commands/vhal_proxy_server/kuksa/proto/kuksa/val/v1/val.proto b/host/commands/vhal_proxy_server/kuksa/proto/kuksa/val/v1/val.proto
new file mode 100644
index 000000000..71d5597aa
--- /dev/null
+++ b/host/commands/vhal_proxy_server/kuksa/proto/kuksa/val/v1/val.proto
@@ -0,0 +1,115 @@
+/********************************************************************************
+ * Copyright (c) 2022 Contributors to the Eclipse Foundation
+ *
+ * See the NOTICE file(s) distributed with this work for additional
+ * information regarding copyright ownership.
+ *
+ * This program and the accompanying materials are made available under the
+ * terms of the Apache License 2.0 which is available at
+ * http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ ********************************************************************************/
+
+syntax = "proto3";
+
+package kuksa.val.v1;
+
+option go_package = "kuksa/val/v1";
+
+import "kuksa/val/v1/types.proto";
+
+// Note on authorization:
+// Tokens (auth-token or auth-uuid) are sent as (GRPC / http2) metadata.
+//
+// The auth-token is a JWT compliant token as the examples found here:
+// https://github.com/eclipse/kuksa.val/tree/master/kuksa_certificates/jwt
+//
+// See also https://github.com/eclipse/kuksa.val/blob/master/doc/jwt.md
+//
+// Upon reception of auth-token, server shall generate an auth-uuid in metadata
+// that the client can use instead of auth-token in subsequent calls.
+
+service VAL {
+  // Get entries
+  rpc Get(GetRequest) returns (GetResponse);
+
+  // Set entries
+  rpc Set(SetRequest) returns (SetResponse);
+
+  // Subscribe to a set of entries
+  //
+  // Returns a stream of notifications.
+  //
+  // InvalidArgument is returned if the request is malformed.
+  rpc Subscribe(SubscribeRequest) returns (stream SubscribeResponse);
+
+  // Shall return information that allows the client to determine
+  // what server/server implementation/version it is talking to
+  // eg. kuksa-databroker 0.5.1
+  rpc GetServerInfo(GetServerInfoRequest) returns (GetServerInfoResponse);
+}
+
+// Define which data we want
+message EntryRequest {
+  string path           = 1;
+  View view             = 2;
+  repeated Field fields = 3;
+}
+
+// Request a set of entries.
+message GetRequest {
+  repeated EntryRequest entries = 1;
+}
+
+// Global errors are specified in `error`.
+// Errors for individual entries are specified in `errors`.
+message GetResponse {
+  repeated DataEntry entries     = 1;
+  repeated DataEntryError errors = 2;
+  Error error                    = 3;
+}
+
+// Define the data we want to set
+message EntryUpdate {
+  DataEntry entry       = 1;
+  repeated Field fields = 2;
+}
+
+// A list of entries to be updated
+message SetRequest {
+  repeated EntryUpdate updates = 1;
+}
+
+// Global errors are specified in `error`.
+// Errors for individual entries are specified in `errors`.
+message SetResponse {
+  Error error                    = 1;
+  repeated DataEntryError errors = 2;
+}
+
+// Define what to subscribe to
+message SubscribeEntry {
+  string path           = 1;
+  View view             = 2;
+  repeated Field fields = 3;
+}
+
+// Subscribe to changes in datapoints.
+message SubscribeRequest {
+  repeated SubscribeEntry entries = 1;
+}
+
+// A subscription response
+message SubscribeResponse {
+  repeated EntryUpdate updates = 1;
+}
+
+message GetServerInfoRequest {
+  // Nothing yet
+}
+
+message GetServerInfoResponse {
+  string name    = 1;
+  string version = 2;
+}
diff --git a/host/commands/vhal_proxy_server/kuksa/test/mapping_test.cpp b/host/commands/vhal_proxy_server/kuksa/test/mapping_test.cpp
new file mode 100644
index 000000000..fb2a77daa
--- /dev/null
+++ b/host/commands/vhal_proxy_server/kuksa/test/mapping_test.cpp
@@ -0,0 +1,79 @@
+// Plain-C++ unit test, no gtest: g++ -std=c++17 -I.. mapping_test.cpp ../KuksaMapping.cpp
+#include "KuksaMapping.h"
+
+#include <cmath>
+#include <cstdio>
+
+using namespace cuttlefish::kuksa_vhal;
+
+static int failures = 0;
+#define CHECK(c) do { if (!(c)) { std::printf("FAIL %s:%d %s\n", __FILE__, __LINE__, #c); ++failures; } } while (0)
+
+static KuksaValue num(double d) { KuksaValue v; v.d = d; return v; }
+static KuksaValue boolean(bool b) { KuksaValue v; v.isBool = true; v.b = b; return v; }
+static KuksaValue str(const char* s) { KuksaValue v; v.isString = true; v.s = s; return v; }
+static bool near(float a, float b) { return std::fabs(a - b) < 1e-3; }
+
+int main() {
+    // Speed km/h -> m/s
+    auto r = toVhal(Conv::kSpeed, num(72.0));
+    CHECK(r && r->size() == 1 && (*r)[0].prop == kPerfVehicleSpeed && near((*r)[0].floats[0], 20.0f));
+    CHECK(!toVhal(Conv::kSpeed, num(300.0)));
+    CHECK(!toVhal(Conv::kSpeed, boolean(true)));
+
+    // Fan: level <-> percent round trip for all 8 levels
+    const int pct[8] = {0, 14, 29, 43, 57, 71, 86, 100};
+    for (int lv = 0; lv < 8; ++lv) {
+        auto f = toVhal(Conv::kFanSpeed, num(pct[lv]));
+        CHECK(f && (*f)[0].ints[0] == lv);
+        VhalValue vv{kHvacFanSpeed, kAreaSeatRow1Left, {lv}, {}};
+        auto k = toKuksa(Conv::kFanSpeed, vv);
+        CHECK(k && static_cast<int>(k->d) == pct[lv]);
+    }
+    CHECK(!toVhal(Conv::kFanSpeed, num(101)));
+
+    // Air distribution
+    auto a = toVhal(Conv::kAirDistribution, str("MIDDLE"));
+    CHECK(a && (*a)[0].ints[0] == 3);
+    CHECK(!toVhal(Conv::kAirDistribution, str("LEFT")));
+    VhalValue dir{kHvacFanDirection, kAreaSeatRow1Left, {2}, {}};
+    CHECK(toKuksa(Conv::kAirDistribution, dir)->s == "DOWN");
+    dir.ints = {4};  // DEFROST bit has no VSS value
+    CHECK(!toKuksa(Conv::kAirDistribution, dir));
+
+    // Gear
+    struct { int vss; int32_t vhal; } gears[] = {{-1, 2}, {0, 1}, {1, 0x10}, {2, 0x20}, {5, 0x100},
+                                                 {6, 0x200}, {126, 4}, {127, 8}};
+    for (auto& g : gears) {
+        auto r2 = toVhal(Conv::kGear, num(g.vss));
+        CHECK(r2 && r2->size() == 2 && (*r2)[0].ints[0] == g.vhal && (*r2)[1].prop == kCurrentGear);
+    }
+    CHECK(!toVhal(Conv::kGear, num(50)));
+
+    // Fuel: 50% of 15000 mL; low only at 0%
+    auto fu = toVhal(Conv::kFuel, num(50));
+    CHECK(fu && near((*fu)[0].floats[0], 7500.0f) && (*fu)[1].ints[0] == 0);
+    CHECK((*toVhal(Conv::kFuel, num(0)))[1].ints[0] == 1);
+    CHECK((*toVhal(Conv::kFuel, num(1)))[1].ints[0] == 0);
+
+    // Temperature clamp on write, reject on read
+    VhalValue t{kHvacTemperatureSet, kAreaSeatRow1Left, {}, {32.5f}};
+    CHECK(near(toKuksa(Conv::kTemperature, t)->d, 30.0f));
+    CHECK(!toVhal(Conv::kTemperature, num(15.0)));
+
+    // Booleans / door / airbag
+    CHECK((*toVhal(Conv::kDoorOpen, boolean(true)))[0].ints[0] == 1);
+    CHECK((*toVhal(Conv::kAirbag, boolean(true)))[0].ints[0] == 2);
+    CHECK((*toVhal(Conv::kSeatBelt, boolean(false)))[0].ints[0] == 0);
+    CHECK((*toVhal(Conv::kDefrost, boolean(true)))[0].area == kAreaWindowFrontWindshield);
+
+    // ESC / ABS are not connected
+    for (auto& b : bindings()) {
+        CHECK(std::string(b.path).find("ESC") == std::string::npos);
+        CHECK(std::string(b.path).find("ABS") == std::string::npos);
+        CHECK(b.writable == stateProp(b.conv).has_value());
+    }
+
+    std::printf(failures ? "FAILED (%d)\n" : "OK\n", failures);
+    return failures != 0;
+}
